[
  {
    "id": "google-pkce-client",
    "find": "x4(j4,_4,{auth:{storage:S4(),persistSession:!0,autoRefreshToken:!0}})",
    "replace": "x4(j4,_4,{auth:{...googleAuthOptions(dkGoogleStep,S4()),persistSession:!0,autoRefreshToken:!0}})"
  },
  {
    "id": "google-login-route",
    "find": "path:\"/login\",element:i.jsx(h3,{})",
    "replace": "path:\"/login\",element:dkGoogleStep?i.jsx(DK.GoogleTransition,{step:dkGoogleStep}):i.jsx(h3,{})"
  },
  {
    "id": "account-tab-entry",
    "find": "handleForgotPassword:s}=f3();return",
    "replace": "handleForgotPassword:s}=f3(),tabs=DK.useAccountTabs();return"
  },
  {
    "id": "account-tab-default",
    "find": "i.jsxs(ng,{defaultValue:\"login\",className:\"space-y-4\"",
    "replace": "i.jsxs(ng,{value:tabs.value,onValueChange:tabs.select,className:\"space-y-4\""
  },
  {
    "id": "google-login-option",
    "find": "children:i.jsx(u3,{onSubmit:n,onForgotPassword:s,isLoading:e,error:t})",
    "replace": "children:i.jsxs(i.Fragment,{children:[i.jsx(DK.GoogleOption,{mode:\"login\"}),i.jsx(u3,{onSubmit:n,onForgotPassword:s,isLoading:e,error:t})]})"
  },
  {
    "id": "google-signup-option",
    "find": "children:i.jsx(d3,{onSubmit:r,isLoading:e,error:t})",
    "replace": "children:i.jsxs(i.Fragment,{children:[i.jsx(DK.GoogleOption,{mode:\"signup\"}),i.jsx(d3,{onSubmit:r,isLoading:e,error:t})]})"
  },
  {
    "id": "account-login-copy",
    "find": "i.jsx(qe,{children:\"Use your email and password to sign in or create an account.\"})",
    "replace": "i.jsx(qe,{children:\"Sign in or create an account.\"})"
  }
]
